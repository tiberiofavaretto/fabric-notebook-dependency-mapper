   "source": [
    "# Daily sales aggregate for reporting.\n",
    "spark.sql(\"\"\"\n",
    "    CREATE TABLE gold.daily_sales AS\n",
    "    SELECT order_date, sum(amount) AS revenue\n",
    "    FROM silver.fct_orders\n",
    "    GROUP BY order_date\n",
    "\"\"\")"
   ]
  }
 ],
